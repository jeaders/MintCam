#!/usr/bin/env bash
# MintCam launcher.
#
# The Python dependencies (PyQt6, opencv, numpy, Pillow, pyzbar) come from the
# distribution, declared in the package Depends. Nothing is downloaded at run
# time, so the app starts immediately and behaves the same everywhere.
set -euo pipefail

APP_DIR="/usr/share/mintcam"
cd "$APP_DIR"
exec python3 -m app.main "$@"
