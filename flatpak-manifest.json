{
    "app-id": "io.github.jeaders.MintCam",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "mintcam",
    "finish-args": [
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--device=all",
        "--filesystem=home",
        "--socket=session-bus"
    ],
    "modules": [
        {
            "name": "python3",
            "buildsystem": "simple",
            "build-commands": [
                "python3 -m ensurepip",
                "mkdir -p /app/wheels && tar xf flatpak-wheels.tar.gz -C /app/wheels",
                "pip3 install --no-cache-dir --no-index --find-links=file:///app/wheels --target=/app/lib/python3/dist-packages --only-binary=:all: opencv-python-headless==4.14.0.94 numpy==2.5.3 PySide6==6.11.2 pyzbar==0.1.9 Pillow==12.3.0"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "flatpak-wheels.tar.gz"
                }
            ]
        },
        {
            "name": "mintcam",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/mintcam && cp -r app /app/mintcam/app",
                "install -D packaging/mintcam.desktop /app/share/applications/io.github.jeaders.MintCam.desktop",
                "sed -i 's|^Icon=.*|Icon=io.github.jeaders.MintCam|' /app/share/applications/io.github.jeaders.MintCam.desktop",
                "install -D mintcam.appdata.xml /app/share/metainfo/io.github.jeaders.MintCam.appdata.xml",
                "install -D packaging/mintcam-launcher-flatpak /app/bin/mintcam",
                "chmod +x /app/bin/mintcam",
                "install -Dm644 assets/mintcam.png /app/share/icons/hicolor/256x256/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-16.png /app/share/icons/hicolor/16x16/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-32.png /app/share/icons/hicolor/32x32/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-48.png /app/share/icons/hicolor/48x48/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-64.png /app/share/icons/hicolor/64x64/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-128.png /app/share/icons/hicolor/128x128/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-256.png /app/share/icons/hicolor/256x256/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 assets/icons/mintcam-512.png /app/share/icons/hicolor/512x512/apps/io.github.jeaders.MintCam.png",
                "install -Dm644 requirements.txt /app/mintcam/requirements.txt",
                "install -Dm644 LICENSE /app/share/licenses/io.github.jeaders.MintCam/LICENSE"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
