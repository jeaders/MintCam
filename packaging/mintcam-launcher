#!/usr/bin/env bash
set -euo pipefail
APP_DIR="/usr/share/mintcam"
USER_VENV="$HOME/.local/share/mintcam/.venv"
if [ ! -d "$USER_VENV" ]; then
    mkdir -p "$HOME/.local/share/mintcam"
    python3 -m venv "$USER_VENV"
    "$USER_VENV/bin/pip" install -r "$APP_DIR/requirements.txt"
fi
cd "$APP_DIR"
source "$USER_VENV/bin/activate"
export QT_QPA_PLATFORM_PLUGIN_PATH="$(python -c 'import PySide6; print(PySide6.__path__[0])')/Qt/plugins"
python -m app.main
