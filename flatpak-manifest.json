{
    "app-id": "org.mintcam.MintCam",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "mintcam",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--device=all",
        "--filesystem=home",
        "--filesystem=xdg-run",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--env=PYTHONPATH=/app/lib/python3.12/site-packages"
    ],
    "modules": [
        {
            "name": "python3",
            "buildsystem": "simple",
            "build-commands": [
                "python3 -m ensurepip",
                "pip3 install --prefix=/app --no-cache-dir numpy opencv-python-headless PySide6 pyzbar Pillow"
            ]
        },
        {
            "name": "mintcam",
            "buildsystem": "simple",
            "build-commands": [
                "cp -r app /app/mintcam",
                "install -D packaging/mintcam.desktop /app/share/applications/org.mintcam.MintCam.desktop",
                "install -D mintcam.appdata.xml /app/share/metainfo/org.mintcam.MintCam.appdata.xml",
                "install -D packaging/mintcam-launcher /app/bin/mintcam",
                "install -Dm644 assets/mintcam.png /app/share/icons/hicolor/256x256/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-16.png /app/share/icons/hicolor/16x16/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-32.png /app/share/icons/hicolor/32x32/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-48.png /app/share/icons/hicolor/48x48/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-64.png /app/share/icons/hicolor/64x64/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-128.png /app/share/icons/hicolor/128x128/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-256.png /app/share/icons/hicolor/256x256/apps/mintcam.png",
                "install -Dm644 assets/icons/mintcam-512.png /app/share/icons/hicolor/512x512/apps/mintcam.png",
                "install -Dm644 requirements.txt /app/mintcam/requirements.txt",
                "sed -i 's|Exec=/usr/bin/mintcam|Exec=mintcam|' /app/share/applications/org.mintcam.MintCam.desktop",
                "sed -i 's|Icon=mintcam|Icon=mintcam|' /app/share/applications/org.mintcam.MintCam.desktop",
                "chmod +x /app/bin/mintcam"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
